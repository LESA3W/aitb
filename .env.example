# Expected environment variables. Copy to .env and fill in.
# The real .env is never committed.

# Prop firm or broker account
FTMO_LOGIN=
FTMO_PASSWORD=
FTMO_SERVER=

# Prop firm guard rail
PROPFIRM_ENABLED=false
PROPFIRM_MAX_TOTAL_LOSS=10
PROPFIRM_MAX_DAILY_LOSS=5
PROPFIRM_BALANCE=0

# Diagnostic scripts (tools/connection_test.py)
MT5_LOGIN=
MT5_PASSWORD=

# Dashboards: listening address, 127.0.0.1 by default
AITB_DASHBOARD_BIND=127.0.0.1
AITB_CRYPTO_BIND=127.0.0.1
