# Variables d'environnement attendues. Copier en .env et remplir.
# Le vrai fichier .env n'est jamais versionne.

# Compte prop firm ou courtier
FTMO_LOGIN=
FTMO_PASSWORD=
FTMO_SERVER=

# Garde-fou prop firm
PROPFIRM_ENABLED=false
PROPFIRM_MAX_TOTAL_LOSS=10
PROPFIRM_MAX_DAILY_LOSS=5
PROPFIRM_BALANCE=0

# Scripts de diagnostic (outils/connection_test.py)
MT5_LOGIN=
MT5_PASSWORD=

# Tableaux de bord : adresse d'ecoute, 127.0.0.1 par defaut
AITB_DASHBOARD_BIND=127.0.0.1
AITB_CRYPTO_BIND=127.0.0.1
